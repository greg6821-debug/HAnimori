{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HAniMori",
  "version": "../package.json",
  "identifier": "com.foulnike.animori",
  "build": {
    "frontendDist": "../dist/app",
    "beforeBuildCommand": "npm run build:app",
    "beforeDevCommand": {
      "script": "npm run build:app",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' ipc: http://ipc.localhost blob: data: http: https:; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.dailymotion.com; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ greg6821-debug/HAnimori/releases/download/windows-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCQzdFOTJGMTk2RjNGQzAKUldUQVAyOFpMK25IZS9UNDRuYTA4bEgzR3Z6ZDJOblFWSjNDQ21HRVlQWWVmRVFJeW51TmZjcTcK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "licenseFile": "license.rtf",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
